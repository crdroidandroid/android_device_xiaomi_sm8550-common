# Camera
allow platform_app_all adsprpcd_file:dir { getattr search read watch };
allow platform_app_all hal_camera_default:binder { call transfer };
allow platform_app_all hal_camera_default:binder transfer;
allow platform_app_all hal_camera_default:fd *;
allow platform_app_all hal_quickcamera_hwservice:hwservice_manager find;
allow platform_app_all hal_quickcamera:binder { call transfer };
allow platform_app_all hal_quickcamera:binder transfer;
allow platform_app_all hal_quickcamera:fd *;
allow platform_app_all hal_quickcamera_default:binder { call transfer };
allow platform_app_all hal_quickcamera_default:binder transfer;
allow platform_app_all hal_quickcamera_default:fd *;
allow platform_app_all vendor_file:dir { watch };
allow platform_app_all vendor_hal_camerapostproc_xiaomi:binder { call transfer };
allow platform_app_all vendor_hal_camerapostproc_xiaomi:binder transfer;
allow platform_app_all vendor_hal_camerapostproc_xiaomi:fd *;
get_prop(platform_app_all, qemu_hw_prop)
get_prop(platform_app_all, vendor_camera_sensor_prop)
get_prop(platform_app_all, vendor_camera_p3enable_prop)
hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app_36, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app, hal_quickcamera)
hal_client_domain(platform_app_36, hal_quickcamera)
hal_client_domain(platform_app, vendor_hal_dspmanager)
hal_client_domain(platform_app_36, vendor_hal_dspmanager)
dontaudit hal_camera_default shell_data_file:dir search;

# Dolby
allow platform_app_all hal_dms_hwservice:hwservice_manager find;
binder_call(platform_app_all, hal_dms_default)

# SoterService
allow platform_app_all vendor_hal_soter_hwservice:hwservice_manager find;
binder_call(platform_app_all, vendor_hal_soter_qti)
