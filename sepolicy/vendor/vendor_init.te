set_prop(vendor_init, vendor_nfc_mi_prop)
set_prop(vendor_init, vendor_fp_prop)

# Allow vendor_init to set thermal prop
set_prop(vendor_init, vendor_thermal_normal_prop)
set_prop(vendor_init, audio_prop)
set_prop(vendor_init, vendor_qcc_prop)

# Allow vendor_init to disable WALT input boost
allow vendor_init proc_walt:dir search;
allow vendor_init proc_walt:file w_file_perms;
